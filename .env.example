# ──────────────────────────────────────────────
# PEvO — shared environment for backend + frontend
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Docker Compose database ──────────────────
# Required — docker-compose will fail without these
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me

# ── App identity ──────────────────────────────
# Change for alpha/testing to use separate on-chain namespace
APP_TAG=pevo
APP_VERSION=0.1
HIVE_ADMIN_ACCOUNT=pevo.admin
HIVE_ANON_ACCOUNT=pevo.anon
# Comma-separated accounts authorized to broadcast accreditations (in addition to HIVE_ADMIN_ACCOUNT)
ACCREDITATION_AUTHORITIES=
# Bridge papers are posted under this account (defaults to HIVE_ADMIN_ACCOUNT)
# HIVE_BRIDGE_ACCOUNT=pevo.bridge

# ── Hive ──────────────────────────────────────
HIVE_API_NODES=https://api.hive.blog,https://api.deathwing.me,https://anyx.io

# Posting keys (keep secret)
PEVO_ADMIN_POSTING_KEY=
PEVO_ANON_POSTING_KEY=
# Only needed if HIVE_BRIDGE_ACCOUNT differs from HIVE_ADMIN_ACCOUNT
# PEVO_BRIDGE_POSTING_KEY=

# ── Databases ─────────────────────────────────
# HAF SQL (read-only, for complex chain queries)
HAF_DATABASE_URL=postgresql://user:password@haf-host:5432/haf_db

# App database (local PostgreSQL — only needed for email notification preferences)
APP_DATABASE_URL=postgresql://pevo:pevo_dev@localhost:5432/pevo_app

# ── Session auth ─────────────────────────────
# Random 32+ char string for signing session JWTs. Required in production.
SESSION_SECRET=

# ── Light accounts (custodial onboarding) ────
# Hive account that claims free account creation tokens via RC delegation
HIVE_ONBOARD_ACCOUNT=
# Active key for the onboard account (needed for claim_account + create_claimed_account)
HIVE_ONBOARD_ACTIVE_KEY=
# Set to false to disable background account creation token claiming (default: true)
CLAIM_ACCOUNT_TOKENS=true
# 32-byte hex secret for encrypting stored posting/memo keys (AES-256-GCM)
# Must differ from SESSION_SECRET. Generate with: openssl rand -hex 32
CUSTODY_ENCRYPTION_KEY=
# Extra institutional email domains beyond the swot academic database (comma-separated).
# Entries starting with "." match as suffixes; others match as exact domains.
# Example: .gov,.gc.ca,.mil,fraunhofer.de,cern.ch
INSTITUTIONAL_EMAIL_DOMAINS=.gov,.gc.ca,canada.ca,.mil,fraunhofer.de,mpg.de,helmholtz.de,leibniz-gemeinschaft.de,cnrs.fr,inria.fr,inserm.fr,cea.fr,csic.es,cern.ch,psi.ch,riken.jp,aist.go.jp,nims.go.jp,ukri.org,infn.it,cnr.it,cas.cn

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL is no longer used (legacy Next.js)

# ── IPFS ─────────────────────────────────────
# Local Kubo node is used by default. Override for a public gateway.
# IPFS_GATEWAY_URL=http://ipfs:8080/ipfs/

# Optional: Pinata fallback for uploads when local node is unavailable
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# Max upload size in bytes (default: 10MB)
# MAX_UPLOAD_SIZE=10485760

# ── Anonymous reviews ─────────────────────────
# 32-byte hex key for AES-256-GCM
ANON_REVIEW_ENCRYPTION_KEY=
# Previous encryption key (for key rotation — only needed during rotation)
# ANON_REVIEW_ENCRYPTION_KEY_PREV=
# Key version (increment when rotating keys)
# ANON_REVIEW_KEY_VERSION=1

# ── SMTP (signup verification, password reset, accreditation) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pevo.science

# ── Redis ────────────────────────────────────
# Required for reputation batch computation (voter weight convergence).
# Without Redis, all voter weights stay at bootstrap mode (1.0).
# Also used for: ORCID state, caching.
# REDIS_URL is auto-constructed from REDIS_PASSWORD when not set (host: redis:6379).
# Override REDIS_URL for non-Docker setups (e.g. redis://:pass@localhost:6379).
REDIS_PASSWORD=
REDIS_URL=

# ── ORCID OAuth2 (optional) ──────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/accreditation/orcid/callback

# ── DataCite (optional — DOI assignment) ──────
DATACITE_REPOSITORY_ID=
DATACITE_PASSWORD=
DATACITE_DOI_PREFIX=
DATACITE_API_URL=https://api.datacite.org

# ── Contact / Community ──────────────────────
CONTACT_EMAIL=support@pevo.science
DISCORD_URL=https://discord.gg/jqvmz7wdPV
GITHUB_URL=https://github.com/pharesim/pevo-science

# ── Logging ─────────────────────────────────
# LOG_LEVEL=info

# ── Sentry (optional) ────────────────────────
# SENTRY_DSN=
