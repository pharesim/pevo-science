# ──────────────────────────────────────────────
# PEvO — shared environment for backend + frontend
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# ── Docker Compose database ──────────────────
POSTGRES_PASSWORD=pevo_dev

# ── App identity ──────────────────────────────
# Change for alpha/testing to use separate on-chain namespace
APP_TAG=pevo
APP_VERSION=0.1
HIVE_ADMIN_ACCOUNT=pevo.admin
HIVE_ANON_ACCOUNT=pevo.anon
# Bridge papers are posted under this account (defaults to HIVE_ADMIN_ACCOUNT)
# HIVE_BRIDGE_ACCOUNT=pevo.bridge

# (Frontend derives NEXT_PUBLIC_APP_TAG / NEXT_PUBLIC_APP_VERSION from these
#  automatically via next.config.mjs — no need to set them separately.)

# ── Hive ──────────────────────────────────────
HIVE_API_NODES=https://api.hive.blog,https://api.deathwing.me,https://anyx.io

# Posting keys (keep secret)
PEVO_ADMIN_POSTING_KEY=
PEVO_ANON_POSTING_KEY=
# Only needed if HIVE_BRIDGE_ACCOUNT differs from HIVE_ADMIN_ACCOUNT
# PEVO_BRIDGE_POSTING_KEY=

# ── Databases ─────────────────────────────────
# HAF SQL (read-only, for complex chain queries)
HAF_DATABASE_URL=postgresql://user:password@haf-host:5432/haf_db

# App database (local PostgreSQL — tokens, anon mappings, preferences)
APP_DATABASE_URL=postgresql://pevo:pevo_dev@localhost:5432/pevo_app

# ── Session auth ─────────────────────────────
# Random 32+ char string for signing session JWTs. Required in production.
SESSION_SECRET=

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
# Local dev: point to backend directly. Production with reverse proxy: use base domain (no /api suffix).
# Frontend routes already include /api/ prefix, so never append /api here.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side rendering (inside Docker) uses this to reach the backend.
# Not needed for local dev without Docker.
#INTERNAL_API_URL=http://backend:3001

# ── IPFS (Pinata) ────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_KEY=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── Anonymous reviews ─────────────────────────
# 32-byte hex key for AES-256-GCM
ANON_REVIEW_ENCRYPTION_KEY=
# Previous encryption key (for key rotation — only needed during rotation)
# ANON_REVIEW_ENCRYPTION_KEY_PREV=
# Key version (increment when rotating keys)
# ANON_REVIEW_KEY_VERSION=1

# ── SMTP (accreditation email verification) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pevo.science

# ── Redis (optional — caching, ORCID state) ──
REDIS_PASSWORD=
REDIS_URL=

# ── ORCID OAuth2 (optional) ──────────────────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/accreditation/orcid/callback

# ── DataCite (optional — DOI assignment) ──────
DATACITE_REPOSITORY_ID=
DATACITE_PASSWORD=
DATACITE_DOI_PREFIX=
DATACITE_API_URL=https://api.datacite.org

# ── Contact / Community ──────────────────────
CONTACT_EMAIL=support@pevo.science
NEXT_PUBLIC_CONTACT_EMAIL=support@pevo.science
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite-code
NEXT_PUBLIC_GITHUB_ISSUES_URL=https://github.com/pevo-science/pevo/issues

# ── Logging ─────────────────────────────────
# LOG_LEVEL=info

# ── Sentry (optional) ────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
