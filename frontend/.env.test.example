# frontend/.env.test — local E2E-only env
#
# Copy to frontend/.env.test (gitignored) and fill in the secret the local
# dev backend is configured with. E2E specs read this file via
# frontend/tests/e2e/fixtures/auth.js and frontend/tests/e2e/global-setup.js.
#
# DO NOT put a production SESSION_SECRET here. This file is intentionally
# separate from the repo-root .env so CI and developer laptops can't
# accidentally mint JWTs that authenticate against a live deployment.
#
# Note on the env-var name: fixtures honour process.env.E2E_SESSION_SECRET
# as an explicit override (NOT process.env.SESSION_SECRET). That keeps the
# backend's own SESSION_SECRET — which Docker Compose injects into every
# shell in the workspace — from silently leaking into fixture JWT minting.
# Inside *this file* the key is still `SESSION_SECRET` (same value the
# backend container reads); only the process-env override is renamed.

# HS256 shared secret the backend uses to sign/verify session JWTs. Must
# match the SESSION_SECRET the local pevo-backend container boots with.
SESSION_SECRET=replace-me-with-local-dev-secret

# Postgres URL for the E2E-only pevo_app_test database. The backend's
# test-db:reset hook and the spec-local queryAppDb helper both refuse to
# run unless the database name ends in `_test`.
APP_DATABASE_URL=postgresql://pevo:pevo_dev@localhost:5432/pevo_app_test
