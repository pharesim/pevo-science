# frontend/.env.test — local E2E-only env
#
# Copy to frontend/.env.test (gitignored) and fill in the secrets the local
# dev backend is configured with. E2E specs read this file via
# frontend/tests/e2e/fixtures/auth.js and frontend/tests/e2e/global-setup.js.
#
# DO NOT put a production SESSION_SECRET here. This file is intentionally
# separate from the repo-root .env so CI and developer laptops can't
# accidentally mint JWTs that authenticate against a live deployment.
#
# Note on the env-var name: fixtures honour process.env.E2E_SESSION_SECRET
# as an explicit override (NOT process.env.SESSION_SECRET). That keeps the
# backend's own SESSION_SECRET — which Docker Compose injects into every
# shell in the workspace — from silently leaking into fixture JWT minting.
# Inside *this file* the key is still `SESSION_SECRET` (same value the
# backend container reads); only the process-env override is renamed.
#
# The `APP_DATABASE_URL` and `REDIS_URL` entries below are host addresses
# that answer only while the stack runs under `./deploy.sh test-up`: that
# override publishes Postgres and Redis on 127.0.0.1, and `./deploy.sh up`
# or `restart` drops both mappings again (`test-db-up` never adds them).
# Keep the literal `127.0.0.1` rather than `localhost`: the mapping binds
# IPv4 only, and `localhost` can resolve to `::1` first.

# HS256 shared secret the backend uses to sign/verify session JWTs. Must
# match the SESSION_SECRET the local pevo-backend container boots with.
SESSION_SECRET=replace-me-with-local-dev-secret

# The key the backend encrypts custody keys with. Must match the
# CUSTODY_ENCRYPTION_KEY the local pevo-backend container boots with; the
# seed-phrase recovery specs encrypt a seeded account's memo key with it.
# The process-env override is E2E_CUSTODY_ENCRYPTION_KEY, for the reason the
# note on E2E_SESSION_SECRET gives. DO NOT put a production key here.
CUSTODY_ENCRYPTION_KEY=replace-me-with-local-dev-key

# Postgres URL for the E2E-only pevo_app_test database. The backend's
# test-db:reset hook and the spec-local queryAppDb helper both refuse to
# run unless the database name ends in `_test`.
APP_DATABASE_URL=postgresql://pevo:pevo_dev@127.0.0.1:5432/pevo_app_test

# The dev Redis, published on loopback by the same `test-up` override. The
# harness touches two key families in it: global-setup clears
# `${APP_TAG}:rl:*` so specs that drive signup and recovery don't 429 on
# quota an earlier run left behind, and global-teardown deletes the
# `${APP_TAG}:ipfs:pending:<cid>` entry for each CID a run pinned.
# global-setup fails the run when this value is missing, unreachable, or
# carries the wrong password: a skipped reset surfaces later as intermittent
# 429s in whichever signup or recovery spec happens to run first, which is
# far more expensive to read than a named failure up front. global-teardown
# only warns, since its specs have already reported by the time it runs.
# Fill in REDIS_PASSWORD from the repo-root .env.
REDIS_URL=redis://:change_me@127.0.0.1:6379
